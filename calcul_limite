

import sympy as sp

x = sp.Symbol('x', real=True)

def calcul_limite(expression, destination):
    fonctions = {
        "x": x,
        "sqrt": sp.sqrt,
        "atan": sp.atan,
        "asin": sp.asin,
        "acos": sp.acos,
        "sin": sp.sin,
        "cos": sp.cos,
        "tan": sp.tan,
        "log": sp.log,
        "exp": sp.exp,
        "pi": sp.pi,
        "oo": sp.oo
    }

    try:
        f = sp.sympify(expression, locals=fonctions)
        a = sp.sympify(destination, locals=fonctions)

        resultat = sp.limit(f, x, a)
        resultat = sp.simplify(resultat)

        if resultat.has(sp.Limit):
            return {
                "statut": "incomplet",
                "resultat": str(resultat),
                "message": "Limite non resolue completement."
            }

        return {
            "statut": "succes",
            "resultat": str(resultat),
            "forme_exacte": sp.sstr(resultat),
            "message": "Calcul termine."
        }

    except (ValueError, TypeError, SyntaxError) as erreur:
        return {
            "statut": "erreur",
            "resultat": None,
            "message": "Expression mathematique invalide."
        }

    except Exception:
        return {
            "statut": "erreur",
            "resultat": None,
            "message": "Impossible de calculer cette limite."
        }
