import streamlit as st
import sympy as sp

st.set_page_config(page_title="حساب النهايات", page_icon="🧮")
st.title("🧮 حساب النهايات - Calcul des Limites")

x = sp.Symbol('x')

st.write("اختر دالة لحساب النهاية عند ما لا نهاية:")

options = {
    "sqrt(x**2 + 1) - x": "sqrt(x**2 + 1) - x",
    "atan(x)/x": "atan(x)/x",
    "(sqrt(x+1)-1)/x": "(sqrt(x+1)-1)/x",
    "(x**2-1)/(x-1)": "(x**2-1)/(x-1)"
}

choice = st.selectbox("اختر الدالة:", list(options.keys()))

if st.button("احسب النهاية"):
    expr_str = options[choice]
    expr = sp.sympify(expr_str)
    
    try:
        lim_inf = sp.limit(expr, x, sp.oo)
        lim_moins_inf = sp.limit(expr, x, -sp.oo)
        
        st.success(f"نهاية {expr_str} عند +∞ هي: {lim_inf}")
        st.info(f"نهاية {expr_str} عند -∞ هي: {lim_moins_inf}")
        
        st.latex(f"\\lim_{{x \\to \\infty}} {sp.latex(expr)} = {sp.latex(lim_inf)}")
        
    except Exception as e:
        st.error(f"خطأ: {e}")

st.markdown("---")
st.write("يمكنك أيضا كتابة دالة بنفسك:")
custom = st.text_input("اكتب الدالة مثلا: sin(x)/x")

if custom:
    try:
        expr_custom = sp.sympify(custom)
        lim = sp.limit(expr_custom, x, sp.oo)
        st.success(f"النهاية عند +∞ هي: {lim}")
    except Exception as e:
        st.error(f"تأكد من كتابة الدالة بشكل صحيح")

